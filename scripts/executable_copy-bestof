#!/usr/bin/env python3

import argparse
import os.path
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any, Generator
import platform
import PIL.Image

IMAGE_EXTENSIONS = {".jpg", ".jpeg"}

VIDEO_EXTENSIONS = {".mp4", ".mov"}

IMAGE_PATTERN = "*.[jJ][pP][gG]"

VIDEO_PATTERN = "*.[mM][pP]4"


def iter_files(root: Path, extensions: set[str]) -> Generator[Path, Any, None]:
    for path in root.rglob("*"):
        if path.is_file() and path.suffix.lower() in extensions:
            yield path


def is_locked(path: Path) -> bool:
    if platform.system() == "Darwin" or platform.system() == "Linux":
        result = subprocess.run(
            ["stat", "-f", "%Sf", str(path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )

        if result.returncode != 0:
            return False

        flags = result.stdout.strip()
        return "uchg" in flags or "schg" in flags
    else:
        return not os.access(path, os.W_OK)


def get_exif_date_with_exif_tool(path: Path) -> str | None:
    result = subprocess.run(
        [
            "exiftool",
            "-s3",
            "-d",
            "%Y-%m-%d_%H-%M-%S",
            "-DateTimeOriginal",
            "-CreateDate",
            str(path),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )

    if result.returncode != 0:
        return None

    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return lines[0] if lines else None


def get_exif_date_with_pil(path: Path) -> str | None:
    try:
        with PIL.Image.open(path) as img:
            exif_data = img._getexif()
            if not exif_data:
                return None

            date_str = exif_data.get(36867) or exif_data.get(306)
            if not date_str:
                return None

            dt = datetime.strptime(date_str, "%Y:%m:%d %H:%M:%S")
            return dt.strftime("%Y-%m-%d_%H-%M-%S")
    except Exception:
        return None


def get_exif_date(path: Path) -> str | None:
    if shutil.which("exiftool") is None:
        return get_exif_date_with_pil(path)
    else:
        return get_exif_date_with_exif_tool(path)


def get_file_modified_date(path: Path) -> str:
    modified = datetime.fromtimestamp(path.stat().st_mtime)
    return modified.strftime("%Y-%m-%d_%H-%M-%S")


def copy_locked_images(source: Path, destination: Path):
    found = 0
    locked = 0
    copied = 0
    skipped = 0

    for image in iter_files(source, IMAGE_EXTENSIONS):
        found += 1

        if not is_locked(image):
            continue

        locked += 1

        ts = get_exif_date(image) or get_file_modified_date(image)

        day = ts.split("_")[0]
        day_folder = destination / day
        day_folder.mkdir(parents=True, exist_ok=True)

        output = day_folder / f"{ts}_{image.stem}{image.suffix}"

        if output.exists():
            skipped += 1
            print(f"{output} already copied.")
            continue

        print(f"Copying: {image} -> {output.name}")
        shutil.copy(image, output)
        copied += 1

    return found, locked, copied, skipped


def copy_videos(source: Path, destination: Path):
    found = 0
    copied = 0
    skipped = 0

    for video in iter_files(source, VIDEO_EXTENSIONS):
        found += 1

        output = destination / video.name

        if output.exists():
            skipped += 1
            print(f"{output} already copied.")
            continue

        print(f"Copying: {video} -> {output.name}")
        shutil.copy(video, output)
        copied += 1

    return found, skipped, copied


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("card", help="The mounted path of the SD card")
    parser.add_argument("--folder", help="Optional folder name inside ~/Pictures/Bestof")
    parser.add_argument("--videos", action="store_true", help="Also copy videos")

    args = parser.parse_args()

    source = Path(args.card).expanduser().resolve()

    if not source.is_dir():
        print(f"Source folder not found: {source}")
        sys.exit(1)

    destination = Path.home() / "Pictures" / "Bestof"

    if args.folder:
        destination = destination / args.folder

    destination.mkdir(parents=True, exist_ok=True)

    found, locked, copied, skipped = copy_locked_images(source, destination)
    print("Done.")
    print(f"Found images: {found}")
    print(f"Locked images: {locked}")
    print(f"Copied: {copied}")
    print(f"Skipped existing: {skipped}")

    if args.videos:
        found_videos, skipped_videos, copied_videos = copy_videos(source, destination)
        print(f"Found videos: {found_videos}")
        print(f"Copied videos: {copied_videos}")
        print(f"Skipped existing videos: {skipped_videos}")


if __name__ == "__main__":
    main()
