#!/usr/bin/env bash

set -euo pipefail

folder="${1:-}"

if [[ -z "$folder" || ! -d "$folder" ]]; then
	echo "Usage: $0 <folder>"
	exit 1
fi

find "$folder" -maxdepth 1 -type f \( \
	-iname "*.raf" -o \
	-iname "*.jpg" -o \
	-iname "*.jpeg" -o \
	-iname "*.mov" \
	\) -print0 |
	while IFS= read -r -d '' file; do
		dir="$(dirname "$file")"
		filename="$(basename "$file")"

		if [[ "$filename" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_ ]]; then
			echo "Skipping: $filename"
			continue
		fi

		date="$(exiftool -s3 -DateTimeOriginal -d "%Y-%m-%dT%H-%M-%S" "$file")"

		if [[ -z "$date" ]]; then
			date="$(exiftool -s3 -CreateDate -d "%Y-%m-%dT%H-%M-%S" "$file")"
		fi

		if [[ -z "$date" ]]; then
			echo "No capture date: $filename"
			continue
		fi

		new_name="${date}_${filename}"

		if [[ -e "$dir/$new_name" ]]; then
			echo "Already exists: $new_name"
			continue
		fi

		base="${filename%.*}"

		echo "$filename -> $new_name"
		mv -- "$file" "$dir/$new_name"

		sidecar="$dir/${base}.photo-edit"

		if [[ -f "$sidecar" ]]; then
			new_sidecar="$dir/${date}_${base}.photo-edit"

			echo "${base}.photo-edit -> ${date}_${base}.photo-edit"
			mv -- "$sidecar" "$new_sidecar"
		fi
	done
